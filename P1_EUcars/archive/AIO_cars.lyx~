\begin_layout Subsubsection
Merger simulation procedure
\end_layout

\begin_layout Standard
A given firm / car manufacturer 
\begin_inset Formula $f$
\end_inset

 in market 
\begin_inset Formula $t$
\end_inset

 with product portfolio 
\begin_inset Formula $\mathcal{J}_{ft}$
\end_inset

 maximises 
\begin_inset Formula $\sum_{k\in\mathcal{J}_{ft}}M_{t}(p_{kt}-c_{kt})s_{kt}(\mathbf{p}_{t})$
\end_inset

 yielding first order conditions 
\begin_inset Formula $s_{jt}(\mathbf{p}_{t})=-\sum_{k\in\mathcal{J}_{f}}(p_{kt}-c_{kt})\frac{\partial s_{kt}}{\partial p_{jt}},$
\end_inset

 for all products 
\begin_inset Formula $j\in\mathcal{J}_{ft}$
\end_inset

.
 Stacking the FOCs for all firms:
\begin_inset Formula 
\begin{equation}
\underbrace{\begin{bmatrix}s_{1t}(\mathbf{p}^{*}_{t})\\
s_{2t}(\mathbf{p}^{*}_{t})\\
\vdots\\
s_{Jt}(\mathbf{p}^{*}_{t})
\end{bmatrix}}_{\equiv\mathbf{s}_{t}(\mathbf{p}^{*}_{t})}=-\mathcal{H}\odot\underbrace{\begin{bmatrix}\frac{\partial s_{1t}(\mathbf{p}^{*}_{t})}{\partial p_{1t}} & \frac{\partial s_{2t}(\mathbf{p}^{*}_{t})}{\partial p_{1t}} & \cdots & \frac{\partial s_{Jt}(\mathbf{p}^{*}_{t})}{\partial p_{1t}}\\
